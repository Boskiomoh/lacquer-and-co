# Copy to .env.local and fill in. Every integration is optional: anything left
# empty falls back to an honest demo mode instead of failing.

# Public site URL, used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mapbox GL public token (pk.*). Public by necessity, so restrict it by URL in
# the Mapbox dashboard. Empty = static map image fallback.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Stripe TEST MODE secret key (sk_test_*). Live keys are refused.
# Empty = bookings are held as "deposit pending".
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_*), printed by:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# Cal.com API key plus one event type id per package.
# Any of the four empty = local demo availability with a visible banner.
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_CORRECTION=
CALCOM_EVENT_TYPE_SIGNATURE=
CALCOM_EVENT_TYPE_INTERIOR=

# Resend API key. Empty = emails are logged server-side, UI says "queued".
RESEND_API_KEY=
# Sender, e.g. "Lacquer & Co. <studio@yourdomain.com>" (defaults to the Resend sandbox sender)
RESEND_FROM=
